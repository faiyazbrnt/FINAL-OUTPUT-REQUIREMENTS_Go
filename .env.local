# Shared local dev config for backend + frontend

# Backend
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Supabase (use non-production project)
SUPABASE_URL=YOUR_SUPABASE_URL_OR_PROJECT_ID
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# AI provider
AI_PROVIDER=gemini
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=YOUR_GROQ_API_KEY
GROQ_MODEL=llama3-8b-8192

# Frontend (Vite reads VITE_* keys)
VITE_API_BASE_URL=http://localhost:5000/api
VITE_APP_TITLE=DataInsights Analytics Dashboard (Local Dev)
